# One-step embedded-weight images:
#   voxtral-0.1.0  native 480 ms realtime, recommended/default
#   qwen-0.1.0     revision-capable Chinese/dialect streaming
STT_IMAGE=ghcr.io/lxk36/xgc2-stt-service:voxtral-0.1.0
# For a private mirror, override STT_IMAGE in the untracked local .env file.
STT_VARIANT=voxtral
# Local management WebUI. Keep this loopback-only.
STT_WEB_BIND_ADDRESS=127.0.0.1
STT_WEB_PORT=34896
# LAN/reverse-proxy API. This port never serves the WebUI.
STT_API_BIND_ADDRESS=0.0.0.0
STT_API_PORT=34897

STT_GPU_MEMORY_UTILIZATION=0.80
STT_MAX_MODEL_LEN=32768
STT_MAX_NUM_SEQS=8
STT_MAX_ACTIVE_STREAMS=1
STT_SILENCE_COMMIT_MS=3000
STT_STARTUP_TIMEOUT_SECONDS=3600
STT_VLLM_ENFORCE_EAGER=false

STT_MAX_UPLOAD_BYTES=52428800
STT_CORS_ORIGINS=*
STT_LOG_LEVEL=info
STT_VLLM_LOG_LEVEL=info
STT_GPU_METRICS_ENABLED=true
STT_GPU_METRICS_INTERVAL_SECONDS=2

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
