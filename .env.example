# One-step embedded-weight images:
#   voxtral-0.1.0  native 480 ms realtime, recommended/default
#   qwen-0.1.0     Chinese/dialect comparison, 5 s vLLM chunks
STT_IMAGE=ghcr.io/lxk36/xgc2-stt-service:voxtral-0.1.0
# For a private mirror, override STT_IMAGE in the untracked local .env file.
STT_VARIANT=voxtral
STT_BIND_ADDRESS=0.0.0.0
STT_PORT=8000

STT_GPU_MEMORY_UTILIZATION=0.80
STT_MAX_MODEL_LEN=32768
STT_MAX_NUM_SEQS=8
STT_STARTUP_TIMEOUT_SECONDS=3600
STT_VLLM_ENFORCE_EAGER=false

STT_MAX_UPLOAD_BYTES=52428800
STT_API_KEY=
STT_CORS_ORIGINS=*
STT_LOG_LEVEL=info
STT_VLLM_LOG_LEVEL=info

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
